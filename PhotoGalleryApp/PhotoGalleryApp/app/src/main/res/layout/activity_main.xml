<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Category Tabs -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout android:orientation="horizontal">

            <Button android:id="@+id/allBtn" android:text="All"/>
            <Button android:id="@+id/natureBtn" android:text="Nature"/>
            <Button android:id="@+id/cityBtn" android:text="City"/>
            <Button android:id="@+id/animalBtn" android:text="Animals"/>
            <Button android:id="@+id/foodBtn" android:text="Food"/>
            <Button android:id="@+id/travelBtn" android:text="Travel"/>

        </LinearLayout>
    </HorizontalScrollView>

    <!-- Selection Toolbar -->
    <LinearLayout
        android:id="@+id/selectionBar"
        android:visibility="gone"
        android:background="#333"
        android:padding="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/selectedCount"
            android:textColor="#fff"
            android:text="0 selected"/>

        <Button android:id="@+id/deleteBtn" android:text="Delete"/>
        <Button android:id="@+id/shareBtn" android:text="Share"/>
    </LinearLayout>

    <!-- Grid -->
    <GridView
        android:id="@+id/gridView"
        android:numColumns="2"
        android:verticalSpacing="5dp"
        android:horizontalSpacing="5dp"
        android:layout_below="@id/selectionBar"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

</RelativeLayout>